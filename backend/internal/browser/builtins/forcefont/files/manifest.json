{
  "manifest_version": 3,
  "name": "Force Font",
  "version": "4.1.0",
  "description": "Force Font — 强制网页字体。默认 Monaco + 95% 微软雅黑，可改为 American Typewriter + 思源宋体或自定义组合；智能避让图标字体与代码块",
  "key": "",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "Force Font 字体设置",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": [
        "*://*.seedr.cc/*",
        "*://console.cloud.google.com/cloudshell*"
      ],
      "js": ["settings.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
